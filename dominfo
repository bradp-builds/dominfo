#!/bin/bash

if (( BASH_VERSINFO[0] < 4 )); then
	printf 'Error: Bash 4 or newer is required.\n' >&2
	exit 1
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

declare -A asn_cache ns_cache
asn_result=""

print_header() {
	echo ""
	echo -e "${BOLD}${BLUE}════════════════════════════════════════════════════════${NC}"
	echo -e "${BOLD}${BLUE}  $1${NC}"
	echo -e "${BOLD}${BLUE}════════════════════════════════════════════════════════${NC}"
}

print_section() {
	echo ""
	echo -e "${BOLD}${CYAN}[ $1 ]${NC}"
}

print_subsection() {
	echo -e "  ${YELLOW}$1:${NC}"
}

convert_timestamp() {
	local ts="$1"
	if [[ "$ts" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z?$ ]]; then
		date -d "$ts" +"%Y-%m-%d %H:%M:%S %Z" 2>/dev/null || echo "$ts"
	else
		echo "$ts"
	fi
}

# Read only numeric IPv4 bootstrap addresses from the official root hints format.
root_addresses() {
	awk '
		toupper($1) ~ /^[A-M]\.ROOT-SERVERS\.NET\.$/ && $(NF-1) == "A" {
			n = split($NF, octets, "."); valid = (n == 4)
			for (i = 1; i <= n; i++)
				if (octets[i] !~ /^[0-9]+$/ || octets[i] > 255) valid = 0
			if (valid && !seen[$NF]++) print $NF
		}'
}

load_root_hints() {
	local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dominfo"
	local cache_file="$cache_dir/root-hints" modified now hints temporary today cached_date
	root_ips=""
	now=$(date +%s)
	modified=$(stat -c %Y "$cache_file" 2>/dev/null) || modified=0
	today=$(date -d "@$now" +%F)
	cached_date=$(date -d "@$modified" +%F)
	# A cache from yesterday expires at local midnight, regardless of its age.
	if (( modified > 0 && now >= modified )) && [[ "$cached_date" == "$today" ]]; then
		root_ips=$(root_addresses < "$cache_file")
		[[ -n "$root_ips" ]] && return 0
	fi

	if ! hints=$(curl -fsS --proto '=https' --connect-timeout 3 --max-time 10 \
		https://www.internic.net/domain/named.root 2>/dev/null) || \
		[[ -z $(printf '%s\n' "$hints" | root_addresses) ]]; then
		printf 'Root hints unavailable or invalid; using Google fallback.\n' >&2
		return 1
	fi
	root_ips=$(printf '%s\n' "$hints" | root_addresses)
	# A complete download replaces the cache atomically; failed downloads never refresh it.
	if mkdir -p "$cache_dir" 2>/dev/null && \
		temporary=$(mktemp "$cache_dir/root-hints.XXXXXX" 2>/dev/null); then
		if ! { printf '%s\n' "$hints" > "$temporary" && mv -f "$temporary" "$cache_file"; }; then
			rm -f "$temporary"
			printf 'Could not save root hints; using fresh download for this run.\n' >&2
		fi
	else
		printf 'Could not cache root hints; using fresh download for this run.\n' >&2
	fi
}

# Try multiple current root addresses within a total 15-second trace budget.
trace_dns() {
	local root trace remaining deadline=$((SECONDS + 15))
	while read -r root; do
		[[ -n "$root" ]] || continue
		remaining=$((deadline - SECONDS))
		(( remaining > 0 )) || break
		if trace=$(timeout "$remaining" dig @"$root" "$1" "$2" +trace +comments +nodnssec +time=2 +tries=1 2>/dev/null); then
			printf '%s\n' "$trace"
			return 0
		fi
	done <<< "$root_ips"
	return 1
}

# Follow delegations, then resolve each nameserver address through a fresh trace.
# Return "nameserver address" pairs so record queries never resolve @hostnames.
find_authoritative_ns() {
	local trace servers ns type addresses address
	trace=$(trace_dns "$1" NS) || return 1
	servers=$(printf '%s\n' "$trace" | awk '
		$4 == "NS" {
			if ($1 != zone) { zone = $1; servers = "" }
			servers = servers $5 "\n"
		}
		END { printf "%s", servers }
	')
	while read -r ns; do
		[[ -n "$ns" ]] || continue
		for type in A AAAA; do
			trace=$(trace_dns "$ns" "$type") || continue
			# Only accept the final authoritative answer for this exact hostname.
			# Intermediate glue, referrals and aliases are not address answers.
			addresses=$(printf '%s\n' "$trace" | awk -v name="$ns" -v type="$type" '
				/^;; ->>HEADER<<-/ { ok = ($0 ~ /status: NOERROR,/); aa = 0; ips = "" }
				/^;; flags:/ { aa = ($0 ~ /flags:.* aa[; ]/) }
				tolower($1) == tolower(name) && $4 == type { ips = ips $5 "\n" }
				END { if (ok && aa) printf "%s", ips }
			')
			while read -r address; do
				[[ -n "$address" ]] && printf '%s %s\n' "$ns" "$address"
			done <<< "$addresses"
		done
	done <<< "$servers"
}

query_dns() {
	local record_type="$1" name="$2"
	local servers="$authoritative_ns" ns address response mode
	dns_result=""

	# A delegated subdomain may have different authoritative servers.
	if [[ "$name" != "$domain" ]]; then
		if [[ ! ${ns_cache[$name]+cached} ]]; then
			ns_cache[$name]=$(find_authoritative_ns "$name")
		fi
		servers="${ns_cache[$name]}"
	fi
	while read -r ns address; do
		[[ -n "$address" ]] || continue
		mode=+norecurse
		[[ "$ns" == Google ]] && mode=+recurse
		response=$(dig @"$address" "$name" "$record_type" "$mode" +time=3 +tries=1 \
			+noall +comments +answer +stats 2>/dev/null) || continue
		# Empty authoritative answers (including NXDOMAIN) are valid, not failures.
		[[ "$response" =~ status:\ (NOERROR|NXDOMAIN), ]] || continue
		if [[ "$ns" != Google ]]; then
			[[ "$response" =~ flags:[^\;]*[[:space:]]aa[\;[:space:]] ]] || continue
		fi
		printf '    DNS %s %s — %s (%s)' "$name" "$record_type" "$ns" \
			"$(printf '%s\n' "$response" | sed -n 's/^;; SERVER: //p')"
		[[ "$ns" == Google ]] && printf ' (Google fallback; potentially cached)'
		printf '\n'
		# Select the requested RR type, excluding CNAMEs from address results.
		dns_result=$(printf '%s\n' "$response" | awk -v type="$record_type" '
			$0 !~ /^;/ && $4 == type {
				sub(/^[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+/, "")
				print
			}')
		return 0
	done <<< "$servers
Google 8.8.8.8"
	printf '    DNS lookup failed for %s %s (authoritative servers and Google).\n' "$name" "$record_type" >&2
	return 1
}

lookup_asn() {
	local ip="$1"

	if [[ -n "${asn_cache[$ip]}" ]]; then
		asn_result="${asn_cache[$ip]}"
		return
	fi

	local response
	response=$(curl -fsS --connect-timeout 3 --max-time 8 "http://ip-api.com/json/$ip?fields=as,asname" 2>/dev/null)
	if [ -z "$response" ]; then
		asn_result=""
		return
	fi

	local asn_info asn_name
	asn_info=$(echo "$response" | grep -o '"as":"AS[0-9]*' | cut -d'"' -f4)
	asn_name=$(echo "$response" | grep -o '"as":"[^"]*"' | cut -d'"' -f4 | sed 's/AS[0-9]* *//')

	if [ -n "$asn_info" ] && [ -n "$asn_name" ]; then
		asn_cache[$ip]="$asn_info ($asn_name)"
		asn_result="${asn_cache[$ip]}"
	else
		asn_result=""
	fi
}

get_registration_info() {
	print_section "Registration"

	if ! whois_output=$(timeout 15 whois "$domain" 2>/dev/null); then
		echo "  WHOIS lookup failed or timed out."
		return
	fi

	if [ -z "$whois_output" ]; then
		echo -e "${RED}No WHOIS data available${NC}"
		return
	fi

	echo -e "  ${YELLOW}Registrar:${NC} $(echo "$whois_output" | grep -i "Registrar:" | head -1 | awk -F: '{print $2}' | xargs)"
	echo -e "  ${YELLOW}Registrar URL:${NC} $(echo "$whois_output" | grep -i "Registrar URL:" | head -1 | awk -F': ' '{for(i=2;i<=NF;i++) printf "%s", $i; print ""}' | xargs)"

	created=$(echo "$whois_output" | grep -i "Creation Date:" | head -1 | awk -F': ' '{for(i=2;i<=NF;i++) printf "%s ", $i; print ""}' | xargs)
	expires=$(echo "$whois_output" | grep -i "Expiry Date:" | head -1 | awk -F': ' '{for(i=2;i<=NF;i++) printf "%s ", $i; print ""}' | xargs)
	updated=$(echo "$whois_output" | grep -i "Updated Date:" | head -1 | awk -F': ' '{for(i=2;i<=NF;i++) printf "%s ", $i; print ""}' | xargs)

	echo -e "  ${YELLOW}Registered:${NC} $(convert_timestamp "$created")"
	echo -e "  ${YELLOW}Expires:${NC} $(convert_timestamp "$expires")"
	echo -e "  ${YELLOW}Updated:${NC} $(convert_timestamp "$updated")"
	echo -e "  ${YELLOW}Status:${NC}"

	local statuses
	statuses=$(echo "$whois_output" | grep -i "Domain Status:" | grep -v "(" | sed 's/^[^:]*: *//' | sort -f -u)
	while read -r status; do
		echo -e "    ${GREEN}→${NC} $status"
	done <<< "$statuses"
}

get_name_servers() {
	print_subsection "Name Servers"

	query_dns "NS" "$domain" || return
	ns_output="$dns_result"

	if [ -z "$ns_output" ]; then
		echo -e "    ${RED}No name servers found${NC}"
	else
		while read -r ns; do
			echo -e "    ${GREEN}→${NC} $ns"
		done <<< "$ns_output"
	fi
}

get_ip_records() {
	print_section "IP Addresses"

	query_dns "A" "$domain" || return
	a_output="$dns_result"
	query_dns "AAAA" "$domain" || return
	aaaa_output="$dns_result"

	print_subsection "IPv4"
	if [ -z "$a_output" ]; then
		echo -e "    ${RED}No A records found${NC}"
	else
		while read -r ip; do
			lookup_asn "$ip"
			if [ -n "$asn_result" ]; then
				echo -e "    ${GREEN}→${NC} $ip ${CYAN}[$asn_result]${NC}"
			else
				echo -e "    ${GREEN}→${NC} $ip"
			fi
		done <<< "$a_output"
	fi

	print_subsection "IPv6"
	if [ -z "$aaaa_output" ]; then
		echo -e "    ${RED}No AAAA records found${NC}"
	else
		while read -r ip; do
			lookup_asn "$ip"
			if [ -n "$asn_result" ]; then
				echo -e "    ${GREEN}→${NC} $ip ${CYAN}[$asn_result]${NC}"
			else
				echo -e "    ${GREEN}→${NC} $ip"
			fi
		done <<< "$aaaa_output"
	fi

	print_subsection "www"
	get_www_info
}

get_www_info() {
	www_domain="www.$domain"

	query_dns "CNAME" "$www_domain" || return
	cname_output="$dns_result"
	query_dns "A" "$www_domain" || return
	www_a_output="$dns_result"
	query_dns "AAAA" "$www_domain" || return
	www_aaaa_output="$dns_result"

	if [ -n "$cname_output" ]; then
		echo -e "    ${GREEN}→${NC} CNAME: $cname_output"
	elif [ -n "$www_a_output" ] || [ -n "$www_aaaa_output" ]; then
		if [ -n "$www_a_output" ]; then
			while read -r ip; do
				lookup_asn "$ip"
				if [ -n "$asn_result" ]; then
					echo -e "    ${GREEN}→${NC} IPv4: $ip ${CYAN}[$asn_result]${NC}"
				else
					echo -e "    ${GREEN}→${NC} IPv4: $ip"
				fi
			done <<< "$www_a_output"
		fi
		if [ -n "$www_aaaa_output" ]; then
			while read -r ip; do
				lookup_asn "$ip"
				if [ -n "$asn_result" ]; then
					echo -e "    ${GREEN}→${NC} IPv6: $ip ${CYAN}[$asn_result]${NC}"
				else
					echo -e "    ${GREEN}→${NC} IPv6: $ip"
				fi
			done <<< "$www_aaaa_output"
		fi
	else
		echo -e "    ${RED}No www records found${NC}"
	fi
}

get_mx_records() {
	print_section "Mail Settings"

	print_subsection "MX Records"
	query_dns "MX" "$domain" || return
	mx_output="$dns_result"

	if [ -z "$mx_output" ]; then
		echo -e "    ${RED}No MX records found${NC}"
	else
		local mx_sorted
		mx_sorted=$(echo "$mx_output" | sort -n)
		while read -r mx; do
			priority=$(echo "$mx" | awk '{print $1}')
			server=$(echo "$mx" | awk '{print $2}')
			echo -e "    ${GREEN}→${NC} Priority $priority: $server"
		done <<< "$mx_sorted"
	fi

	get_spf_record
	get_dmarc_record
}

get_spf_record() {
	print_subsection "SPF"

	query_dns "TXT" "$domain" || return
	spf_output=$(printf '%s\n' "$dns_result" | grep -i "v=spf1")

	if [ -z "$spf_output" ]; then
		echo -e "    ${RED}No SPF record found${NC}"
	else
		while read -r spf; do
			echo -e "    ${GREEN}$spf${NC}"
		done <<< "$spf_output"
	fi
}

get_dmarc_record() {
	print_subsection "DMARC"

	query_dns "TXT" "_dmarc.$domain" || return
	dmarc_output=$(printf '%s\n' "$dns_result" | grep -i "v=DMARC1")

	if [ -z "$dmarc_output" ]; then
		echo -e "    ${RED}No DMARC record found${NC}"
	else
		while read -r dmarc; do
			echo -e "    ${GREEN}$dmarc${NC}"
		done <<< "$dmarc_output"
	fi
}

show_help() {
	echo "Usage: $0 [OPTIONS] DOMAIN"
	echo ""
	echo "Get comprehensive DNS and registration information for a domain."
	echo ""
	echo "Options:"
	echo "  -h, --help      Show this help message"
	echo "  -a              Show IP addresses (A, AAAA, www)"
	echo "  -m              Show mail settings (MX, SPF, DMARC)"
	echo "  -r              Show registration info and name servers"
	echo ""
	echo "Examples:"
	echo "  $0 example.com"
	echo "  $0 -a example.com"
	echo "  $0 -m example.com"
	echo "  $0 --help"
}

domain=""
show_all=true
show_ips=false
show_mail=false
show_reg=false

while [[ $# -gt 0 ]]; do
	case $1 in
	-h | --help)
		show_help
		exit 0
		;;
	-a)
		show_all=false
		show_ips=true
		;;
	-m)
		show_all=false
		show_mail=true
		;;
	-r)
		show_all=false
		show_reg=true
		;;
	-n)
		show_all=false
		show_reg=true
		;;
	-s)
		show_all=false
		show_mail=true
		;;
	-d)
		show_all=false
		show_mail=true
		;;
	-*)
		echo -e "${RED}Unknown option: $1${NC}"
		show_help
		exit 1
		;;
	*)
		if [[ -n "$domain" ]]; then
			printf 'Error: Specify only one domain.\n' >&2
			exit 1
		fi
		domain="$1"
		;;
	esac
	shift
done

if [ -z "$domain" ]; then
	echo -e "${RED}Error: Domain required${NC}"
	show_help
	exit 1
fi

domain="${domain,,}"
domain="${domain#http://}"
domain="${domain#https://}"
domain="${domain%%[/?#]*}"
domain="${domain#www.}"
domain="${domain%.}"
if (( ${#domain} > 253 )) || [[ "$domain" != *.* || "$domain" == *. || ! "$domain" =~ ^[a-z0-9.-]+$ ]]; then
	printf 'Error: Invalid domain.\n' >&2
	exit 1
fi
IFS=. read -r -a labels <<< "$domain"
for label in "${labels[@]}"; do
	if (( ${#label} > 63 )) || [[ ! "$label" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]]; then
		printf 'Error: Invalid domain label: %s\n' "$label" >&2
		exit 1
	fi
done

required=(dig timeout curl stat mktemp)
if [[ "$show_all" == true || "$show_reg" == true ]]; then
	required+=(whois)
fi
for tool in "${required[@]}"; do
	if ! command -v "$tool" >/dev/null 2>&1; then
		printf 'Error: Required command missing: %s\n' "$tool" >&2
		exit 1
	fi
done

print_header "Domain Information: $domain"

load_root_hints || :
authoritative_ns=$(find_authoritative_ns "$domain" 2>/dev/null)

if [ "$show_all" = true ]; then
	get_registration_info
	get_name_servers
	get_ip_records
	get_mx_records
else
	[ "$show_reg" = true ] && get_registration_info
	[ "$show_reg" = true ] && get_name_servers
	[ "$show_ips" = true ] && get_ip_records
	[ "$show_mail" = true ] && get_mx_records
fi

echo ""
